{
	"info": {
		"name": "OAuth API",
		"description": "OAuth API endpoints for managing OAuth connections and authorization flows.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8000/api/v1",
			"type": "string"
		},
		{
			"key": "auth_token",
			"value": "",
			"type": "string"
		}
	],
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{auth_token}}",
				"type": "string"
			}
		]
	},
	"item": [
		{
			"name": "CRUD",
			"item": [
				{
					"name": "Get All Connections",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/oauth/connections",
							"host": ["{{base_url}}"],
							"path": ["oauth", "connections"]
						},
						"description": "Get all OAuth connections for the current organization."
					},
					"response": []
				},
				{
					"name": "Get Connection By Provider",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/oauth/connection?provider=google_calendar",
							"host": ["{{base_url}}"],
							"path": ["oauth", "connection"],
							"query": [
								{
									"key": "provider",
									"value": "google_calendar",
									"description": "Provider name (e.g. google_calendar)"
								}
							]
						},
						"description": "Get a specific OAuth connection by provider name. Returns {connected: false} if not found."
					},
					"response": []
				},
				{
					"name": "Disconnect",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{base_url}}/oauth/disconnect?connection_id=1",
							"host": ["{{base_url}}"],
							"path": ["oauth", "disconnect"],
							"query": [
								{
									"key": "connection_id",
									"value": "1",
									"description": "The connection ID to delete"
								}
							]
						},
						"description": "Delete an OAuth connection by ID."
					},
					"response": []
				},
				{
					"name": "List Supported Providers",
					"request": {
						"method": "GET",
						"header": [],
						"auth": {
							"type": "noauth"
						},
						"url": {
							"raw": "{{base_url}}/oauth/providers",
							"host": ["{{base_url}}"],
							"path": ["oauth", "providers"]
						},
						"description": "List all supported OAuth providers. No authentication required."
					},
					"response": []
				}
			]
		},
		{
			"name": "OAuth Flow",
			"item": [
				{
					"name": "Authorize (Google Calendar)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/oauth/google_calendar/authorize",
							"host": ["{{base_url}}"],
							"path": ["oauth", "google_calendar", "authorize"]
						},
						"description": "Initiate OAuth authorization flow for Google Calendar. Returns an auth_url to redirect the user to."
					},
					"response": []
				},
				{
					"name": "Authorize (Generic Provider)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/oauth/:provider/authorize",
							"host": ["{{base_url}}"],
							"path": ["oauth", ":provider", "authorize"],
							"variable": [
								{
									"key": "provider",
									"value": "google_calendar",
									"description": "Provider name (e.g. google_calendar, google_sheets)"
								}
							]
						},
						"description": "Initiate OAuth authorization flow for any supported provider."
					},
					"response": []
				},
				{
					"name": "Callback (Google Calendar)",
					"request": {
						"method": "GET",
						"header": [],
						"auth": {
							"type": "noauth"
						},
						"url": {
							"raw": "{{base_url}}/oauth/google_calendar/callback?code=AUTH_CODE_HERE&state=ORG_ID:USER_ID:google_calendar",
							"host": ["{{base_url}}"],
							"path": ["oauth", "google_calendar", "callback"],
							"query": [
								{
									"key": "code",
									"value": "AUTH_CODE_HERE",
									"description": "Authorization code from provider"
								},
								{
									"key": "state",
									"value": "ORG_ID:USER_ID:google_calendar",
									"description": "State parameter with org_id:user_id:provider"
								}
							]
						},
						"description": "OAuth callback endpoint. Called by the provider after user authorizes. Exchanges code for tokens and creates a connection. Redirects to frontend on success."
					},
					"response": []
				}
			]
		}
	]
}
