{
  "provider": "digitalocean",
  "service": "kubernetes",
  "resource": "digitalocean.KubernetesCluster + KubernetesNodePool",
  "notes": "version resolved from version_prefix via get_kubernetes_versions if 'version' is blank",
  "config": {
    "region": "nyc3",
    "version": "",
    "version_prefix": "1.32.",
    "node_pools": [
      {
        "name": "cpuapp",
        "instance_type": "s-2vcpu-4gb",
        "min": 1,
        "max": 3,
        "desired": 2
      }
    ]
  }
}
