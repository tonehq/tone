{
  "env_name": "tonedo",
  "services": {
    "kubernetes": {
      "provider": "digitalocean",
      "config": {
        "region": "nyc3",
        "version": "",
        "version_prefix": "",
        "node_pools": [
          {
            "name": "cpuapp",
            "instance_type": "s-2vcpu-4gb",
            "min": 2,
            "max": 3,
            "desired": 2
          },
          {
            "name": "workers",
            "instance_type": "s-2vcpu-4gb",
            "min": 1,
            "max": 2,
            "desired": 1
          }
        ]
      }
    },
    "db": {
      "provider": "digitalocean",
      "config": {
        "region": "nyc3",
        "version": "16",
        "size": "db-s-1vcpu-1gb",
        "node_count": 1,
        "database_name": "tone"
      }
    },
    "cache": {
      "provider": "digitalocean",
      "config": {
        "region": "nyc3",
        "engine": "valkey",
        "version": "8",
        "size": "db-s-1vcpu-1gb",
        "node_count": 1,
        "eviction_policy": "allkeys_lru"
      }
    },
    "filestorage": {
      "provider": "cloudflare",
      "config": {
        "account_id": "1b1060704a77f9c68db9b50ec521f5b9",
        "bucket_name": "tonedo-bucket",
        "location": "ENAM",
        "storage_class": "Standard"
      }
    }
  }
}
