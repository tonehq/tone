{
  "env_name": "tonedev",
  "services": {
    "kubernetes": {
      "provider": "digitalocean",
      "config": {
        "region": "nyc3",
        "version": "",
        "version_prefix": "",
        "node_pools": [
          {
            "name": "cpuapp",
            "instance_type": "s-2vcpu-4gb",
            "min": 1,
            "max": 3,
            "desired": 3
          }
        ]
      }
    },
    "db": {
      "provider": "neon",
      "config": {
        "org_id": "org-floral-dew-78790515",
        "region_id": "aws-us-east-1",
        "pg_version": 17,
        "branch_name": "main",
        "database_name": "tone",
        "role_name": "tone_owner"
      }
    },
    "cache": {
      "provider": "upstash",
      "config": {
        "region": "global",
        "primary_region": "us-east-1",
        "read_regions": [],
        "eviction": true,
        "tls": true
      }
    },
    "filestorage": {
      "provider": "cloudflare",
      "config": {
        "account_id": "1b1060704a77f9c68db9b50ec521f5b9",
        "bucket_name": "tonedev-bucket",
        "location": "ENAM",
        "storage_class": "Standard"
      }
    }
  }
}
