FRONTEND_DIR="$(cd "$(dirname "$0")/.." && pwd)"
SCRIPT="$FRONTEND_DIR/.claude/skills/find-impacted-routes/analyze_diff.py"

if [ ! -f "$SCRIPT" ]; then
  exit 0
fi

while read local_ref local_sha remote_ref remote_sha; do
  if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
    continue
  fi

  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    commit1=$(git merge-base main "$local_sha" 2>/dev/null || git rev-parse main 2>/dev/null)
  else
    commit1="$remote_sha"
  fi

  echo ""
  echo "find-impacted-routes: analyzing $commit1...$local_sha"
  echo "Use 'yarn push' for the full workflow (analysis + tests + auto-commit report)."
  echo ""

  python3 "$SCRIPT" \
    --project-path "$FRONTEND_DIR" \
    --commit1 "$commit1" \
    --commit2 "$local_sha" \
    --output "$FRONTEND_DIR"
done

exit 0
